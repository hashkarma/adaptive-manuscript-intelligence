# ============================================================
# Manuscript Intelligence Platform - Git Ignore
# Keep source code, orchestration, tests and frontend in Git.
# Keep generated data, environments, model weights and artifacts out.
# ============================================================

# Python virtual environments
venv/
.venv/
venv-*/
env/
.envdir/

# Python caches / build outputs
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Secrets / local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# macOS / editors
.DS_Store
.AppleDouble
.LSOverride
.vscode/
.idea/
*.swp
*.swo

# Generated manuscript pipeline artifacts
artifacts/
stage5_runtime_logs/
stage6_runtime_logs/
runs/
logs/
*.log

# Raw / temporary manuscript uploads
data/raw/
data/tmp/
data/processed/
!data/raw/.gitkeep

# Downloaded models / weights / NLP resources
models/
model_cache/
.cache/
huggingface/
hf_cache/

# Common ML model / tensor formats
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.tflite

# Generated numeric/vector/index files
*.npy
*.npz
*.faiss
*.index
*.parquet
*.arrow

# Large generated Sanskrit / RAG corpora
knowledge/stage6d_dcs/
knowledge/**/passages.jsonl
knowledge/**/embeddings*
knowledge/**/index*

# Media / archives usually not appropriate for source repo
*.m4a
*.mp3
*.mp4
*.mov
*.avi
*.zip
*.tar
*.tar.gz
*.tgz

# Notebook checkpoints
.ipynb_checkpoints/

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*~

# Downloaded Sanskrit corpora / knowledge resources
knowledge/

# Historical local development snapshots
*_backup.py
*_old.py
*_before_*.py
*.pre_stage5.py
*_pre_stage5.py

# ---------------------------------------------------------------------------
# Local development / professor-showcase transient files
# Managed by showcase normalization. Do not commit machine-specific state.
# ---------------------------------------------------------------------------

# Python environments
.venv/
venv-*/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local logs / temporary files
*.log
tmp.txt
dist/

# One-off local normalization / diagnostic material
showcase/devtools/

# Large intermediate showcase runs. Canonical frozen evidence lives in
# showcase/cases/ instead.
showcase/logs/
showcase/original_stage5_runs/
showcase/qwen_stage5_smoke_runs/
showcase/artifacts_cpu_benchmark/
showcase/run4_line_inventory/
showcase/run4_line_inventory_v2/
showcase/run4_schema_inspection/
showcase/stage4_final_tuning/
showcase/stage4_split_tuning/
showcase/stage4_adaptive_runs/

# Local audit/report outputs
showcase/*_output.txt
showcase/*_diagnostics.txt
showcase/repository_audit_report.*

# Local emergency backups generated during patching
*.pre_showcase_*.bak
*.pre_qwen_showcase.bak

# Local stage-specific environment symlinks
# No trailing slash: these may be symlinks rather than directories.
venv-stage*
venv-provider-*

# Additional local tuning/run directories discovered during final audit
showcase/stage4_tuning_runs/
showcase/stage6_env_freeze/

# Local Qwen scratch area was normalized into data/ + tests/
showcase/qwen_test/

# Runtime-generated artifacts: keep the architectural folder, ignore outputs
artifacts/*
!artifacts/README.md
